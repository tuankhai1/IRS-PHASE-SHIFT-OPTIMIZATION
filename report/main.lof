\babel@toc {english}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces An IRS-aided MISO wireless communication system. The AP transmits signals to the user through both the direct link $\mathbf {h}_d$ and the reflected link via the IRS. The IRS controller adjusts the phase shifts of the $N$ reflecting elements.}}{5}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Achievable rate vs. AP-user horizontal distance ($N = 40$, 300 channel realizations). The metaheuristic algorithms (PSO, GWO) closely match the AO practical baselines while serving as general-purpose alternatives.}}{14}{figure.caption.7}%
\contentsline {figure}{\numberline {3}{\ignorespaces Achievable rate vs. number of IRS reflecting elements ($d = 498$ m, 300 realizations). The rate increases approximately linearly with $N$ for all schemes.}}{15}{figure.caption.8}%
\contentsline {figure}{\numberline {4}{\ignorespaces Achievable rate vs. AP-user distance with discrete phase shifts ($N = 40$, $b = 1, 2, 3$ bits).}}{16}{figure.caption.9}%
\contentsline {figure}{\numberline {5}{\ignorespaces Component-level optimization vs. phase-level AO across AP-user distance ($N = 40$). GWO component-level surpasses both PSO component-level and AO phase-level across all distances.}}{17}{figure.caption.10}%
\contentsline {figure}{\numberline {6}{\ignorespaces Component-level optimization vs. phase-level AO across IRS size ($d = 498$ m). GWO component-level outperforms AO phase-level across all values of $N$, demonstrating the advantage of directly optimizing hardware parameters.}}{17}{figure.caption.11}%
\contentsline {figure}{\numberline {7}{\ignorespaces Convergence of component-level algorithms ($N = 40$, $d = 498$ m). GWO exhibits faster convergence and reaches a higher final value than PSO, due to its multi-leader guidance and quartic decay schedule.}}{18}{figure.caption.12}%
\contentsline {figure}{\numberline {8}{\ignorespaces Fixed-component ablation study ($N = 40$). Fixing $R$ alone causes minimal performance loss, while fixing $C$ leads to significant degradation due to its critical role in controlling varactor capacitance and resonance frequency.}}{19}{figure.caption.13}%
\contentsline {figure}{\numberline {9}{\ignorespaces Phase-level vs. component-level vs. hybrid optimization comparison ($N = 40$). The hybrid approaches significantly outperform standalone component-level optimization by leveraging the phase-level solution as a warm start.}}{20}{figure.caption.14}%
